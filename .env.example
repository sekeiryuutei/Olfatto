# ============================================
# OLFATTO — Environment variables template
# Copy to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# ---------- General ----------
NODE_ENV=development
COMPOSE_PROJECT_NAME=olfatto

# ---------- Backend ----------
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:8100

# ---------- Database ----------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=olfatto
DATABASE_USER=olfatto_user
DATABASE_PASSWORD=change_me_locally

# ---------- JWT ----------
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ---------- Stripe (Olfatto Club) ----------
# Sacá estos valores de https://dashboard.stripe.com (modo test para probar)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLUB_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:8100/profile?club=success
STRIPE_CANCEL_URL=http://localhost:8100/profile?club=canceled
STRIPE_PORTAL_RETURN_URL=http://localhost:8100/profile

# ---------- Frontend (build-time) ----------
API_URL=http://localhost:3000/api/v1
APP_ENV=development

# ---------- pgAdmin (optional, docker-compose.dev.yml) ----------
PGADMIN_DEFAULT_EMAIL=admin@olfatto.local
PGADMIN_DEFAULT_PASSWORD=change_me_locally
